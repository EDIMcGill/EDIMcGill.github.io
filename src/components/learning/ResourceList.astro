---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\ResourceList.astro
interface Resource {
	title: string
	href: string
	description?: string
	external?: boolean
}

interface Props {
	items: Resource[]
	class?: string
}

const { items, class: className = '' } = Astro.props as Props
---

<ul class={`space-y-3 ${className}`}>
	{
		items.map((item) => (
			<li class='rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900'>
				<a
					href={item.href}
					class='font-semibold text-violet-700 hover:underline dark:text-violet-300'
					target={item.external ? '_blank' : undefined}
					rel={item.external ? 'noreferrer noopener' : undefined}
				>
					{item.title}
				</a>
				{item.description && (
					<p class='mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300'>
						{item.description}
					</p>
				)}
			</li>
		))
	}
</ul>
