---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\EvidenceCard.astro
interface Props {
	claim: string
	class?: string
}

const { claim, class: className = '' } = Astro.props as Props
---

<section
	class={`rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900 ${className}`}
>
	<p class='text-xs font-bold uppercase tracking-wide text-violet-700 dark:text-violet-300'>
		Claim
	</p>
	<h3 class='mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100'>{claim}</h3>
	<p class='mt-4 text-xs font-bold uppercase tracking-wide text-violet-700 dark:text-violet-300'>
		Evidence
	</p>
	<div class='mt-2 text-sm leading-7 text-slate-700 dark:text-slate-300'>
		<slot />
	</div>
</section>
