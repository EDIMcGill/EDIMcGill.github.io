---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\Accordion.astro
interface Item {
	title: string
	content: string
	open?: boolean
}

interface Props {
	items: Item[]
	class?: string
}

const { items, class: className = '' } = Astro.props as Props
---

<div class={`learning-accordion space-y-3 ${className}`}>
	{
		items.map((item) => (
			<details
				class='rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900'
				open={item.open}
			>
				<summary class='cursor-pointer list-none font-semibold text-slate-900 dark:text-slate-100'>
					{item.title}
				</summary>
				<div class='mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300'>{item.content}</div>
			</details>
		))
	}
</div>
