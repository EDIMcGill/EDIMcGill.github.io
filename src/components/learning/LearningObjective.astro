---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\LearningObjective.astro
interface Props {
	title?: string
	objectives?: string[]
	class?: string
}

const {
	title = 'Learning objectives',
	objectives = [],
	class: className = ''
} = Astro.props as Props
---

<section
	class={`rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-900 ${className}`}
>
	<p class='text-xs font-bold uppercase tracking-wide text-violet-700 dark:text-violet-300'>
		{title}
	</p>
	<ul class='mt-4 space-y-2 text-sm leading-7 text-slate-700 dark:text-slate-300'>
		{objectives.map((item) => <li>• {item}</li>)}
		<slot />
	</ul>
</section>
