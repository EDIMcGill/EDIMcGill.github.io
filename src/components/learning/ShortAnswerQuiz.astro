---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\ShortAnswerQuiz.astro
interface Props {
	question: string
	placeholder?: string
	buttonLabel?: string
	class?: string
}

const {
	question,
	placeholder = 'Type your answer here...',
	buttonLabel = 'Submit',
	class: className = ''
} = Astro.props as Props
---

<section
	class={`rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 ${className}`}
>
	<h3 class='text-lg font-semibold text-slate-900 dark:text-slate-100'>{question}</h3>
	<form class='mt-4 space-y-3'>
		<textarea
			class='min-h-28 w-full rounded-xl border border-slate-300 bg-white p-3 text-sm text-slate-800 outline-none ring-0 placeholder:text-slate-400 focus:border-violet-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100'
			placeholder={placeholder}></textarea>
		<button
			type='button'
			class='rounded-xl bg-violet-700 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800'
		>
			{buttonLabel}
		</button>
	</form>
</section>
