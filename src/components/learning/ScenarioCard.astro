---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\ScenarioCard.astro
interface Props {
	title: string
	level?: string
	class?: string
}

const { title, level = 'Scenario', class: className = '' } = Astro.props as Props
---

<article
	class={`rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900 ${className}`}
>
	<p class='text-xs font-bold uppercase tracking-wide text-violet-700 dark:text-violet-300'>
		{level}
	</p>
	<h3 class='mt-1 text-xl font-semibold text-slate-900 dark:text-slate-100'>{title}</h3>
	<div class='mt-4 text-sm leading-7 text-slate-600 dark:text-slate-300'>
		<slot />
	</div>
</article>
