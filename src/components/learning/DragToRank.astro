---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\DragToRank.astro
interface Props {
	title?: string
	items: string[]
	class?: string
}

const { title = 'Drag to rank', items, class: className = '' } = Astro.props as Props
---

<section
	class={`rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900 ${className}`}
>
	<h3 class='text-lg font-semibold text-slate-900 dark:text-slate-100'>{title}</h3>
	<p class='mt-2 text-sm text-slate-600 dark:text-slate-300'>
		Static scaffold placeholder for a ranking activity.
	</p>
	<ol class='mt-4 space-y-2'>
		{
			items.map((item, index) => (
				<li class='rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200'>
					<span class='font-bold'>{index + 1}.</span> {item}
				</li>
			))
		}
	</ol>
</section>
