---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\CaseStudyBlock.astro
interface Props {
	title: string
	context?: string
	outcome?: string
	class?: string
}

const {
	title,
	context = 'Context',
	outcome = 'Outcome',
	class: className = ''
} = Astro.props as Props
---

<section
	class={`rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 ${className}`}
>
	<h3 class='text-xl font-semibold text-slate-900 dark:text-slate-100'>{title}</h3>

	<div class='mt-4 grid gap-4 md:grid-cols-2'>
		<div>
			<p class='text-xs font-bold uppercase tracking-wide text-violet-700 dark:text-violet-300'>
				{context}
			</p>
			<div class='mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300'>
				<slot name='context' />
			</div>
		</div>
		<div>
			<p class='text-xs font-bold uppercase tracking-wide text-violet-700 dark:text-violet-300'>
				{outcome}
			</p>
			<div class='mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300'>
				<slot name='outcome' />
			</div>
		</div>
	</div>

	<div
		class='mt-4 rounded-xl bg-slate-50 p-4 text-sm leading-7 text-slate-700 dark:bg-slate-800 dark:text-slate-300'
	>
		<slot />
	</div>
</section>
