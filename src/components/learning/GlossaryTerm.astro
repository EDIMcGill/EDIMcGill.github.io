---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\GlossaryTerm.astro
interface Props {
	term: string
	definition: string
	class?: string
}

const { term, definition, class: className = '' } = Astro.props as Props
---

<span
	class={`group relative inline-flex cursor-help border-b border-dotted border-violet-500 ${className}`}
	tabindex='0'
>
	<span class='font-medium text-violet-700 dark:text-violet-300'>{term}</span>
	<span
		class='pointer-events-none absolute left-0 top-full z-10 mt-2 hidden w-72 rounded-xl border border-slate-200 bg-white p-3 text-sm text-slate-700 shadow-lg group-hover:block group-focus:block dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200'
	>
		{definition}
	</span>
</span>
