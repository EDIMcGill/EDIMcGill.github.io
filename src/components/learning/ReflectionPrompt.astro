---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning/ReflectionPrompt.astro
interface Props {
	title?: string
	prompt?: string
	class?: string
}

const {
	title = 'Reflection prompt',
	prompt = 'Pause and consider:',
	class: className = ''
} = Astro.props as Props
---

<section
	class={`rounded-2xl border-l-4 border-violet-700 bg-violet-50 p-6 dark:bg-violet-950/20 ${className}`}
>
	<p class='text-xs font-bold uppercase tracking-wide text-violet-700 dark:text-violet-300'>
		{prompt}
	</p>
	<h3 class='mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100'>{title}</h3>
	<div class='mt-3 text-sm leading-7 text-slate-700 dark:text-slate-300'>
		<slot />
	</div>
</section>
