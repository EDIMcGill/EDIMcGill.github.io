---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\ComparisonTable.astro
interface Row {
	left: string
	right: string
}

interface Props {
	leftLabel?: string
	rightLabel?: string
	rows: Row[]
	class?: string
}

const {
	leftLabel = 'Concept A',
	rightLabel = 'Concept B',
	rows,
	class: className = ''
} = Astro.props as Props
---

<div
	class={`overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900 ${className}`}
>
	<table class='min-w-full text-left text-sm'>
		<thead class='bg-slate-50 dark:bg-slate-800'>
			<tr>
				<th class='px-4 py-3 font-semibold text-slate-900 dark:text-slate-100'>{leftLabel}</th>
				<th class='px-4 py-3 font-semibold text-slate-900 dark:text-slate-100'>{rightLabel}</th>
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row) => (
					<tr class='border-t border-slate-200 dark:border-slate-700'>
						<td class='px-4 py-3 align-top text-slate-600 dark:text-slate-300'>{row.left}</td>
						<td class='px-4 py-3 align-top text-slate-600 dark:text-slate-300'>{row.right}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>
