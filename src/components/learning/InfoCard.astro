---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\InfoCard.astro
interface Props {
	title: string
	subtitle?: string
	class?: string
}

const { title, subtitle, class: className = '' } = Astro.props as Props
---

<section
	class={`rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900 ${className}`}
>
	<p class='text-xs font-bold uppercase tracking-wide text-violet-700 dark:text-violet-300'>Info</p>
	<h3 class='mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100'>{title}</h3>
	{subtitle && <p class='mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300'>{subtitle}</p>}
	<div class='mt-3 text-sm leading-7 text-slate-700 dark:text-slate-300'>
		<slot />
	</div>
</section>
