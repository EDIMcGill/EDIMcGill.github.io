---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\Stepper.astro
interface Step {
	label: string
	active?: boolean
	done?: boolean
}

interface Props {
	steps: Step[]
	class?: string
}

const { steps, class: className = '' } = Astro.props as Props
---

<div class={`flex flex-wrap gap-3 ${className}`}>
	{
		steps.map((step, index) => (
			<div
				class={`flex items-center gap-2 rounded-full border px-4 py-2 text-sm ${
					step.done
						? 'border-emerald-500 bg-emerald-50 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200'
						: step.active
							? 'border-violet-600 bg-violet-50 text-violet-800 dark:bg-violet-950/40 dark:text-violet-200'
							: 'border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300'
				}`}
			>
				<span class='font-bold'>{index + 1}</span>
				<span>{step.label}</span>
			</div>
		))
	}
</div>
