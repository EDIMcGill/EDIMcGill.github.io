---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\TabbedContent.astro
interface Tab {
	label: string
	content: string
	active?: boolean
}

interface Props {
	tabs: Tab[]
	class?: string
}

const { tabs, class: className = '' } = Astro.props as Props
---

<div
	class={`rounded-2xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900 ${className}`}
>
	<div class='flex flex-wrap gap-2 border-b border-slate-200 p-3 dark:border-slate-700'>
		{
			tabs.map((tab, index) => (
				<button
					type='button'
					class={`rounded-xl px-4 py-2 text-sm font-semibold ${
						tab.active || index === 0
							? 'bg-violet-700 text-white'
							: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200'
					}`}
				>
					{tab.label}
				</button>
			))
		}
	</div>
	<div class='p-5 text-sm leading-7 text-slate-700 dark:text-slate-300'>
		{tabs.find((tab) => tab.active) ?? tabs[0]}
	</div>
</div>
