---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\QuoteBlock.astro
interface Props {
	quote?: string
	author?: string
	role?: string
	class?: string
}

const { quote, author, role, class: className = '' } = Astro.props as Props
---

<blockquote
	class={`rounded-2xl border-l-4 border-violet-700 bg-violet-50 p-6 dark:bg-violet-950/20 ${className}`}
>
	<p class='text-base italic leading-7 text-slate-700 dark:text-slate-300'>“{quote}”</p>
	{
		author && (
			<footer class='mt-3 text-sm font-semibold text-slate-900 dark:text-slate-100'>
				— {author}
				{role ? `, ${role}` : ''}
			</footer>
		)
	}
	<slot />
</blockquote>
