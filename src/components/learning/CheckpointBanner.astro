---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\CheckpointBanner.astro
interface Props {
	title?: string
	status?: string
	class?: string
}

const {
	title = 'Checkpoint',
	status = 'You’re on track',
	class: className = ''
} = Astro.props as Props
---

<div
	class={`rounded-2xl border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-900/40 dark:bg-emerald-950/20 ${className}`}
>
	<p class='text-xs font-bold uppercase tracking-wide text-emerald-700 dark:text-emerald-300'>
		{title}
	</p>
	<p class='mt-1 text-sm font-medium text-slate-800 dark:text-slate-100'>{status}</p>
	<div class='mt-3 text-sm leading-7 text-slate-700 dark:text-slate-300'>
		<slot />
	</div>
</div>
