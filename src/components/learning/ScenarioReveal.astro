interface Props {
	title: string
	class?: string
}

const { title, class: className = '' } = Astro.props as Props
---

<details
	class={`rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900 ${className}`}
>
	<summary class='cursor-pointer list-none font-semibold text-slate-900 dark:text-slate-100'>
		{title}
	</summary>
	<div class='mt-3 text-sm leading-7 text-slate-700 dark:text-slate-300'>
		<slot />
	</div>
</details>
