interface Props {
	title?: string
	class?: string
}

const { title = 'Warning', class: className = '' } = Astro.props as Props
---

<aside
	class={`rounded-2xl border-l-4 border-amber-500 bg-amber-50 p-5 dark:bg-amber-950/20 ${className}`}
>
	<p class='text-xs font-bold uppercase tracking-wide text-amber-700 dark:text-amber-300'>
