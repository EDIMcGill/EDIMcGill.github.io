---
// filepath: c:\Users\User\Desktop\websites\EDIMcGill.github.io\src\components\learning\Timeline.astro
interface Entry {
	title: string
	description: string
	meta?: string
}

interface Props {
	items: Entry[]
	class?: string
}

const { items, class: className = '' } = Astro.props as Props
---

<div class={`space-y-6 ${className}`}>
	{
		items.map((item, index) => (
			<div class='flex gap-4'>
				<div class='flex flex-col items-center'>
					<div class='flex h-8 w-8 items-center justify-center rounded-full bg-violet-700 text-sm font-bold text-white'>
						{index + 1}
					</div>
					{index < items.length - 1 && (
						<div class='mt-2 h-full w-px bg-slate-300 dark:bg-slate-700' />
					)}
				</div>
				<div class='pb-6'>
					<h3 class='text-lg font-semibold text-slate-900 dark:text-slate-100'>{item.title}</h3>
					{item.meta && (
						<p class='text-xs uppercase tracking-wide text-violet-700 dark:text-violet-300'>
							{item.meta}
						</p>
					)}
					<p class='mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300'>
						{item.description}
					</p>
				</div>
			</div>
		))
	}
</div>
